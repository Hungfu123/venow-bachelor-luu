@startuml
package "Domain Layer (Kern)" {
    class User {
        - userId: UUID
        - userName: String
        - email: String
        - password: String
        - role: int // 0 = Schausteller, 1 = Veranstalter
    }

    class Event {
        - id: UUID
        - title: String
        - description: String
        - location: String
        - startDate: LocalDate
        - endDate: LocalDate
        - organizerId: UUID
    }

    class Application {
        - id: UUID
        - userId: UUID
        - eventId: UUID
        - status: String // "beworben", "abgelehnt"
    }

    class Contract {
        - id: UUID
        - applicationId: UUID
        - terms: String
        - status: String // "vertrag", "abgeschlossen"
    }

    interface UserRepository {
        + save(User user)
        + findById(UUID userId): User
    }

    interface EventRepository {
        + save(Event event)
        + findById(UUID eventId): Event
    }

    interface ApplicationRepository {
        + save(Application application)
        + findById(UUID applicationId): Application
    }

    interface ContractRepository {
        + save(Contract contract)
        + findById(UUID contractId): Contract
    }
}

package "Application Layer" {
    class EventService {
        + createEvent(organizerId: UUID)
        + getEventsByOrganizer(UUID organizerId): List<Event>
    }

    class ApplicationService {
        + submitApplication(CreateApplicationRequest request): ApplicationDTO
        + updateApplicationStatus(UUID applicationId, String status)
    }

    class ContractService {
        + createContract(CreateContractRequest request): ContractDTO
        + completeContract(UUID contractId)
    }

    class CreateApplicationRequest {
        - userId: UUID
        - eventId: UUID
        - contactInformation: String
        - businessName: String
        - message: String
    }

    class ApplicationDTO {
        - applicationId: UUID
        - userId: UUID
        - eventId: UUID
        - status: String
    }

    class CreateContractRequest {
        - applicationId: UUID
        - terms: String
        - price: double
    }

    class ContractDTO {
        - contractId: UUID
        - applicationId: UUID
        - terms: String
        - status: String
    }
}

package "Infrastructure Layer" {
    class JpaUserRepository implements UserRepository {
        + save(User user)
        + findById(UUID userId): User
    }

    class JpaEventRepository implements EventRepository {
        + save(Event event)
        + findById(UUID eventId): Event
    }

    class JpaApplicationRepository implements ApplicationRepository {
        + save(Application application)
        + findById(UUID applicationId): Application
    }

    class JpaContractRepository implements ContractRepository {
        + save(Contract contract)
        + findById(UUID contractId): Contract
    }
}

package "Presentation Layer" {
    class EventController {
        + createEvent(CreateEventRequest request)
        + getEventsByOrganizer(UUID organizerId): List<EventDTO>
    }

    class ApplicationController {
        + submitApplication(CreateApplicationRequest request): ApiResponse<ApplicationDTO>
        + updateApplicationStatus(UUID applicationId, String status)
    }

    class ContractController {
        + createContract(CreateContractRequest request): ApiResponse<ContractDTO>
        + completeContract(UUID contractId)
    }

    interface ApiResponse<T> {
        - message: String
        - success: boolean
        - data: T
    }
}

ApplicationService ..> Application : verwendet
ContractService ..> Contract : verwendet
EventService ..> Event : verwendet
ApplicationService ..> ApplicationDTO : verwendet
ContractService ..> ContractDTO : verwendet
EventService ..> UserRepository : verwendet
EventService ..> EventRepository : verwendet
JpaUserRepository ..|> UserRepository
JpaEventRepository ..|> EventRepository
JpaApplicationRepository ..|> ApplicationRepository
JpaContractRepository ..|> ContractRepository
ApplicationController ..> ApplicationService : ruft auf
ContractController ..> ContractService : ruft auf
EventController ..> EventService : ruft auf
@enduml
