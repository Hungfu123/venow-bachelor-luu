@startuml
package "Domain Layer (Kernlogik)" {
    class User {
        - userId: UUID
        - userName: String
        - email: String
        - password: String
        - role: int // 0 = Schausteller, 1 = Veranstalter
    }

    class Event {
        - id: UUID
        - title: String
        - description: String
        - location: String
        - startDate: LocalDate
        - endDate: LocalDate
        - organizerId: UUID
        - List<UUID> participantIds

        + addParticipant(UUID participantId)
        + removeParticipant(UUID participantId)
    }

    class Application {
        - id: UUID
        - userId: UUID
        - eventId: UUID
        - contactInformation: String
        - businessName: String
        - typeOfBusiness: String
        - previousParticipation: boolean
        - message: String
        - status: String // z.B. "beworben", "abgelehnt"

        + accept()
        + reject()
    }

    class Contract {
        - id: UUID
        - applicationId: UUID
        - terms: String
        - price: Preis
        - status: String // z.B. "vertrag", "abgeschlossen"

        + complete()
    }

    class Price {
        - int euroCent
    }

    class ContractDomainService {
        + createContract(Application application, String terms, double price): Contract
    }
}

package "Application Layer" {
    class EventService {
        + createEvent(organizerId: UUID)
        + getEventsByOrganizer(UUID organizerId): List<Event>
        + deleteEventsByOrganizer (UUID organizerId): void
    }

    class ApplicationService {
        + submitApplication(CreateApplicationRequest request): ApplicationDTO
        + updateApplicationStatus(UUID applicationId, String status)
    }

    class ContractService {
        + createContract(CreateContractRequest request): ContractDTO
        + completeContract(UUID contractId)
    }

    interface UserRepository {
        + save(User user)
        + findById(UUID userId): User
    }

    interface EventRepository {
        + save(Event event)
        + findById(UUID eventId): Event
        + findAllByOrganizer(UUID organizerId): List<Event>
    }

    interface ApplicationRepository {
        + save(Application application)
        + findById(UUID applicationId): Application
        + findByEventId(UUID eventId): List<Application>
    }

    interface ContractRepository {
        + save(Contract contract)
        + findById(UUID contractId): Contract
        + findByApplicationId(UUID applicationId): Contract
    }

    class CreateApplicationRequest {
        - userId: UUID
        - eventId: UUID
        - contactInformation: String
        - businessName: String
        - message: String
    }

    class ApplicationDTO {
        - applicationId: UUID
        - userId: UUID
        - eventId: UUID
        - status: String
    }

    class CreateContractRequest {
        - applicationId: UUID
        - terms: String
        - price: double
    }

    class ContractDTO {
        - contractId: UUID
        - applicationId: UUID
        - terms: String
        - status: String
    }
    class NichtVorhandenExceptopn{

}
    class UngueltigeEingabe{

}

package "Infrastructure Layer" {
    class JpaUserRepository implements UserRepository {
        + save(User user)
        + findById(UUID userId): User
    }

    class JpaEventRepository implements EventRepository {
        + save(Event event)
        + findById(UUID eventId): Event
    }

    class JpaApplicationRepository implements ApplicationRepository {
        + save(Application application)
        + findById(UUID applicationId): Application
    }

    class JpaContractRepository implements ContractRepository {
        + save(Contract contract)
        + findById(UUID contractId): Contract
    }
}

package "Presentation Layer (Rollenspezifisch)" {
    class ShowmanApplicationController {
        + submitApplication(CreateApplicationRequest request): ApiResponse<ApplicationDTO>
        + getApplication(UUID applicationId): ApiResponse<ApplicationDTO>
    }

    class ShowmanEventController {
        + getEvents(): ApiResponse<List<EventDTO>>
        + getEvent(UUID eventId): ApiResponse<EventDTO>
    }

    class OrganizerEventController {
        + createEvent(CreateEventRequest request): ApiResponse<EventDTO>
        + updateEvent(UUID eventId, UpdateEventRequest request): ApiResponse<EventDTO>
        + getEvent(UUID eventId): ApiResponse<EventDTO>
    }

    class OrganizerContractController {
        + createContract(CreateContractRequest request): ApiResponse<ContractDTO>
        + getContract(UUID contractId): ApiResponse<ContractDTO>
    }

    interface ApiResponse<T> {
        - message: String
        - success: boolean
        - data: T
    }
}

ApplicationService ..> Application : verwendet
ContractService ..> Contract : verwendet
EventService ..> Event : verwendet
ApplicationService ..> ApplicationDTO : verwendet
ContractService ..> ContractDTO : verwendet
EventService ..> UserRepository : verwendet
EventService ..> EventRepository : verwendet
JpaUserRepository ..|> UserRepository
JpaEventRepository ..|> EventRepository
JpaApplicationRepository ..|> ApplicationRepository
JpaContractRepository ..|> ContractRepository
ShowmanApplicationController ..> ApplicationService : ruft auf
ShowmanEventController ..> EventService : ruft auf
OrganizerEventController ..> EventService : ruft auf
OrganizerContractController ..> ContractService : ruft auf
ContractDomainService ..> Application : verwendet
ContractDomainService ..> Contract : erstellt
User "0..*" -- "0..*" Application : bewirbt sich für
Application "1" -- "1" Contract : führt zu
Event "1" -- "0..*" Application : hat Bewerbungen
User "1" -- "0..*" Event : erstellt
Event "0..*" -- "0..*" User : hat Teilnehmer
@enduml
